# Copy to .env.local — public values only, no secrets.
# Cloud: https://api.zbritjasot.com · https://preview.zbritjasot.com

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: extra next/image hosts (comma-separated, no https://)
# NEXT_PUBLIC_IMAGE_HOSTS=images.zbritjasot.com

# Optional: soft /admin+/biz gate (localhost or SESSION_DOMAIN shared only)
# AUTH_SOFT_GATE=1
# SESSION_COOKIE_NAME=zbritjasot-session
