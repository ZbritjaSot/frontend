# Public API origin only — never secrets or Sanctum keys.
# Local: http://localhost:8000
# Production: https://api.your-domain.com  (must match Laravel APP_URL / Sanctum)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical site origin for metadata, sitemap, robots, and JSON-LD (no trailing slash).
# Defaults to https://www.zbritjasot.com when unset.
# Local preview: http://localhost:3000
# Production: https://www.zbritjasot.com
# NEXT_PUBLIC_SITE_URL=https://www.zbritjasot.com

# Optional extra next/image hostnames (comma-separated).
# Always includes **.r2.dev. Add the public image CDN hostname used in production.
# Example: images.zbritjasot.com or your R2 custom domain (no https://).
# NEXT_PUBLIC_IMAGE_HOSTS=images.zbritjasot.com

# Soft Next proxy gate for /admin and /biz (requires shared session cookie).
# Sanctum session cookies are issued for the API host. Enable only when the browser
# also sends that cookie to the Next host:
#   - localhost (cookie host ignores port), or
#   - production with SESSION_DOMAIN=.yourdomain.com on the Laravel API
# Do NOT enable by default when Next and API are on unrelated hosts — logged-in
# users would bounce to login forever because Next never sees the session cookie.
# AUTH_SOFT_GATE=1
# SESSION_COOKIE_NAME=zbritjasot-session
