# Copy to .env.local — public values only, no secrets.
# Cloud: https://api.zbritjasot.com · https://preview.zbritjasot.com

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: extra next/image hosts (comma-separated, no https://)
# NEXT_PUBLIC_IMAGE_HOSTS=images.zbritjasot.com

# App links served at /.well-known. Without these the routes respond 404.
# APPLE_TEAM_ID=
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:...

# Optional: soft /admin+/biz gate (localhost or SESSION_DOMAIN shared only)
# AUTH_SOFT_GATE=1
# SESSION_COOKIE_NAME=zbritjasot-session

# Sentry error monitoring. Empty DSN = Sentry fully disabled. Set only in Vercel env vars, never commit a real DSN.
# NEXT_PUBLIC_SENTRY_DSN=
# Defaults to "production" on production builds, otherwise "development". Use "preview" on the Preview env.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time only (secret, Vercel env var, NOT public): enables source map upload.
# SENTRY_AUTH_TOKEN=
